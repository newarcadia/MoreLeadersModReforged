			<action type="attachparticle" effect="effects\building_fx\cov\damage\plasmafire_01">GrannyRootBone</action>
		</event>
		<event>
			<action type="swappart">spectre_minordamaged,spectre_mediumdamaged</action>
			<action type="attachparticle" effect="effects\building_fx\cov\damage\plasmafire_02">bone_turret</action>
		</event>
		<event>
			<action type="swappart">spectre_mediumdamaged,spectre_majordamaged</action>
		</event>
		<event>
			<action type="swappart">spectre_majordamaged,spectre_destroyeddamaged</action>
			<action type="throwpart">PassengerLegs_Right</action>
			<action type="throwpart">PassengerTop_Right</action>
			<action type="throwpart">turret</action>
			<action type="throwpart">PassengerTop_Left</action>
			<action type="throwpart">PassengerLegs_Left</action>
			<action type="playsound">play_impact_building_damage_release_electric</action>
			<action type="playsound">play_cov_ghost_death</action>
		</event>
	</percentagebased>
	<impactpointbased />
	<cryopercentagebased>
		<event />
		<event />
		<event />
		<event />
		<event>
			<action type="attachparticle" effect="effects\cryo_bomb\unit_freezing_medium">GrannyRootBone</action>
			<action type="playsound">play_cryo_bomb_freezing</action>
		</event>
	</cryopercentagebased>
	<shatterdeathevent>
		<action type="attachparticle" effect="effects\cryo_bomb\unit_shatter_medium">GrannyRootBone</action>
		<action type="playsound">play_cryo_impact</action>
	</shatterdeathevent>
</damagetemplate>